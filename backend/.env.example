# El backend NO lee ningún .env en esta carpeta ni en la raíz del repositorio.
# La configuración va en ~/.config/drakter/.env: copia la plantilla completa de la raíz
#   mkdir -p ~/.config/drakter && cp -n ../.env.example ~/.config/drakter/.env && chmod 600 ~/.config/drakter/.env
# Guía: docs/installation/configuracion-env.md
