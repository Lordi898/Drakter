{
  "name": "drakter-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Drakter Desktop: interfaz de escritorio del agente personal Drakter",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "dev": "electron-vite dev -- --allow-loopback-in-peer-connection",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview -- --allow-loopback-in-peer-connection",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "@rive-app/canvas": "2.55.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dbus-next": "0.10.2",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "three": "0.180.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "usocket": "$usocket",
    "xml2js": "0.6.2"
  },
  "optionalDependencies": {
    "usocket": "file:./stubs/usocket-absent"
  }
}
