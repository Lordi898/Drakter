{"id": "voz-frase-larga", "user": "Di una frase muy larga.", "min_words": 30, "must_not_match": ["(?i)no (me|le) hace falta", "(?i)no (le )?voy a", "(?i)prefiero no", "(?i)no (lo )?necesit", "(?i)mejor (algo )?(breve|corto)"], "note": "La petición explícita de longitud gana a la brevedad, sin comentarios."}
{"id": "voz-sin-oferta-agenda", "user": "¿Qué tal está hoy?", "no_tools": true, "max_sentences": 3, "must_not_match": ["(?i)agenda", "(?i)tareas?", "(?i)asignaturas?", "(?i)calendario", "(?i)lo que (le )?sirve de verdad"], "note": "Charla: no ofrecer agenda, tareas ni asignaturas sin motivo."}
{"id": "voz-activacion-jarvis", "user": "Hey Jarvis, ¿qué hora es?", "no_tools": true, "max_sentences": 2, "must_match": ["(?i)diez"], "must_not_match": ["(?i)jarvis", "(?i)no soy", "(?i)soy drakter", "(?i)me llamo"], "note": "«Jarvis» es la palabra de activación: no se corrige ni se comenta."}
{"id": "voz-terminal", "user": "Abre la terminal.", "no_tools": true, "max_sentences": 2, "must_match": ["(?i)no (lo )?(puedo|tengo|me es posible|manejo)"], "must_not_match": ["(?i)agenda", "(?i)asignaturas?", "\\n\\s*[-*\\d]"], "note": "Lo que no puede: una frase honesta y breve, sin listas ni ofertas largas."}
{"id": "voz-guardar-sin-guarida", "user": "Apúnteme comprar pan mañana.", "must_not_match": ["(?i)guarida", "(?i)tesoro", "(?i)drag[oó]n", "(?i)colmillo", "(?i)escamas?"], "max_sentences": 2, "note": "Tras guardar, nada de metáforas del dragón en voz."}
