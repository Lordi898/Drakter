# Plantilla de configuración de Drakter. Solo nombres, nunca valores reales.
#
# - Se copia a ~/.config/drakter/.env (o $XDG_CONFIG_HOME/drakter/.env).
# - No se pone en la raíz del repositorio: el backend no lee ningún .env ahí.
# - Este archivo nunca lleva valores reales.
# - Las líneas sin valor (NOMBRE=) se ignoran: se usa el valor por defecto.
#
# No hay puerto ni orígenes que configurar: Electron lanza el backend, que elige
# un puerto efímero en 127.0.0.1 (D-14). Valores por defecto y formato: README.md,
# sección "Configuración".

# --- Backend (backend/app/core/config.py) ---
DRAKTER_DATA_DIR=
DRAKTER_LOG_LEVEL=

# --- Agente (backend/app/integrations/hermes/settings.py) ---
DRAKTER_ENV=
ANTHROPIC_API_KEY=
DRAKTER_AGENT_PROVIDER=
DRAKTER_MODEL_PROVIDER=
DRAKTER_MODEL_NAME=
DRAKTER_HERMES_PYTHON=
DRAKTER_DEV_STUB_URL=

# --- Voz (backend/app/integrations/voice/settings.py, voice/config.py) ---
DRAKTER_VOICE_ENABLED=
DRAKTER_VOICE_PYTHON=
DRAKTER_PIPER_PYTHON=

# Ajustes finos de voz. El backend solo pasa al proceso de voz estos nombres
# (lista blanca en backend/app/integrations/voice/supervisor.py).
DRAKTER_VOICE_MODELS_DIR=
DRAKTER_STT_PROVIDER=
DRAKTER_STT_MODEL=
DRAKTER_STT_DEVICE=
DRAKTER_STT_COMPUTE_TYPE=
DRAKTER_STT_LANGUAGE=
DRAKTER_STT_BEAM_SIZE=
DRAKTER_STT_THREADS=
DRAKTER_TTS_PROVIDER=
DRAKTER_TTS_FALLBACK=
DRAKTER_TTS_VOICE=
DRAKTER_TTS_THREADS=
DRAKTER_PIPER_VOICE=
DRAKTER_VAD_PROVIDER=
DRAKTER_VAD_THRESHOLD=
DRAKTER_VAD_SILENCE_MS=
DRAKTER_VAD_PREROLL_MS=
DRAKTER_VOICE_MAX_UTTERANCE_S=
DRAKTER_WAKEWORD_ENABLED=
DRAKTER_WAKEWORD_PROVIDER=
DRAKTER_WAKEWORD_MODEL=
DRAKTER_WAKEWORD_THRESHOLD=
DRAKTER_VOICE_BARGE_IN=
DRAKTER_VOICE_BARGE_IN_THRESHOLD=
DRAKTER_VOICE_BARGE_IN_MIN_MS=
DRAKTER_AUDIO_BACKEND=
DRAKTER_AUDIO_INPUT=
DRAKTER_AUDIO_OUTPUT=
DRAKTER_VOICE_LEVEL_HZ=
DRAKTER_VOICE_OUTPUT_LATENCY_MS=

# --- Automejora (backend/app/services/improvement_lab.py) ---
DRAKTER_IMPROVEMENT_REPO=

# --- Reservadas: nada las lee todavía ---
OPENVIKING_ENDPOINT=
OPENVIKING_API_KEY=
# Fish Audio (TTS en la nube). Clave secreta: solo en ~/.config/drakter/.env.
FISH_API_KEY=
