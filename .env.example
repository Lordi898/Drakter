# Plantilla de configuración de Drakter. Solo nombres, nunca valores reales.
#
# - Se copia a ~/.config/drakter/.env (o $XDG_CONFIG_HOME/drakter/.env).
# - No se pone en la raíz del repositorio: el backend no lee ningún .env ahí.
# - Este archivo nunca lleva valores reales.
# - AVISO: en el archivo copiado, borra toda línea que dejes sin valor. Solo los
#   ajustes del backend ignoran NOMBRE= vacío; los del agente y la voz lo toman
#   como valor y pueden impedir el arranque.
#
# No hay puerto ni orígenes que configurar: Electron lanza el backend, que elige
# un puerto efímero en 127.0.0.1 (D-14). Valores por defecto y formato: README.md,
# sección "Configuración y secretos".

# --- Backend (backend/app/core/config.py) ---
DRAKTER_DATA_DIR=
DRAKTER_LOG_LEVEL=

# --- Agente (backend/app/integrations/hermes/settings.py) ---
DRAKTER_ENV=
ANTHROPIC_API_KEY=
DRAKTER_AGENT_PROVIDER=
DRAKTER_MODEL_PROVIDER=
DRAKTER_MODEL_NAME=
DRAKTER_HERMES_PYTHON=
DRAKTER_DEV_STUB_URL=

# --- Voz (backend/app/integrations/voice/settings.py, voice/config.py) ---
DRAKTER_VOICE_ENABLED=
DRAKTER_VOICE_PYTHON=
DRAKTER_PIPER_PYTHON=

# --- Automejora (backend/app/services/improvement_lab.py) ---
DRAKTER_IMPROVEMENT_REPO=

# --- Reservadas: nada las lee todavía ---
OPENVIKING_ENDPOINT=
OPENVIKING_API_KEY=
