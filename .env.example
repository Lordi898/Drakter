# Plantilla de configuración de Drakter. Solo nombres, NUNCA valores reales.
#
# Instalación (una vez):
#   mkdir -p ~/.config/drakter
#   cp -n .env.example ~/.config/drakter/.env
#   chmod 600 ~/.config/drakter/.env
#
# - Se lee de ~/.config/drakter/.env (o $XDG_CONFIG_HOME/drakter/.env). Ningún .env en la raíz del
#   repositorio se lee: no copies aquí tus claves.
# - Las líneas sin valor (NOMBRE=) se ignoran y se usa el valor por defecto. Rellena solo lo que
#   necesites; para el modelo real basta ANTHROPIC_API_KEY.
# - Sin espacios alrededor del «=» y sin comillas.
# - No hay puerto que configurar: Electron lanza el backend en 127.0.0.1 con un puerto efímero.
#
# Guía completa, con valores por defecto y ejemplos: docs/installation/configuracion-env.md

# --- Claves (secretos: solo en ~/.config/drakter/.env, permisos 600) ---
# Anthropic: obligatoria para el modelo real (Claude Haiku 5.5).
ANTHROPIC_API_KEY=
# Fish Audio (voz en la nube). Sin ella habla Kokoro, la voz local.
FISH_API_KEY=
# Reconocimiento de voz en la nube (opcionales). Con DEEPGRAM_API_KEY se usa Deepgram Nova-3 (UE);
# si no, con GROQ_API_KEY, Groq Whisper; si no, Moonshine local. Si la nube falla, pasa a local.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# --- Backend (backend/app/core/config.py) ---
# Ruta ABSOLUTA de datos (base de datos, copias, logs). Por defecto ~/.local/share/drakter.
DRAKTER_DATA_DIR=
# DEBUG | INFO | WARNING | ERROR (por defecto INFO).
DRAKTER_LOG_LEVEL=

# --- Agente (backend/app/integrations/hermes/settings.py) ---
# development | production (por defecto development; en production no se admite el stub).
DRAKTER_ENV=
# hermes | fake (por defecto hermes).
DRAKTER_AGENT_PROVIDER=
# anthropic | dev_stub (por defecto anthropic).
DRAKTER_MODEL_PROVIDER=
# Por defecto claude-haiku-5-5.
DRAKTER_MODEL_NAME=
# Python del venv de Hermes. Por defecto «hermes-python» en el PATH (lo crea scripts/install-hermes.sh).
DRAKTER_HERMES_PYTHON=
# Stub de desarrollo (solo http en loopback). Por defecto http://127.0.0.1:28517.
DRAKTER_DEV_STUB_URL=
# Límites del turno del agente (por defecto 12 llamadas, 300 s y 120 s sin actividad).
DRAKTER_AGENT_MAX_TURNS=
DRAKTER_TURN_TIMEOUT_S=
DRAKTER_IDLE_TIMEOUT_S=

# --- Voz: arranque (backend/app/integrations/voice/settings.py) ---
# true | false (por defecto true). Con false no se lanza el proceso de voz.
DRAKTER_VOICE_ENABLED=
# Python del venv de voz (ruta absoluta). Por defecto ~/.local/share/drakter/venvs/voice/bin/python.
DRAKTER_VOICE_PYTHON=

# --- Voz: ajustes finos (voice/config.py) ---
# Cualquier campo de VoiceConfig se puede fijar como DRAKTER_VOICE_<CAMPO_EN_MAYÚSCULAS>; también en
# ~/.config/drakter/voice.toml. Los más útiles:
# Reconocimiento: auto | deepgram | groq | moonshine (por defecto auto, según las claves).
DRAKTER_VOICE_STT=
# Síntesis, en orden de preferencia separado por comas (por defecto fish,kokoro).
DRAKTER_VOICE_TTS=
# Voz de Kokoro (por defecto ef_dora).
DRAKTER_VOICE_KOKORO_VOICE=
# Sensibilidad de la palabra de activación, 0..1 (por defecto 0.3; más alto = menos falsos positivos).
DRAKTER_VOICE_WAKE_THRESHOLD=
# Segundos sin voz tras responder antes de volver a reposo (por defecto 20).
DRAKTER_VOICE_FOLLOWUP_S=
# Hilos por modelo local (por defecto 2).
DRAKTER_VOICE_THREADS=
# Permitir modelos de Fish de pago (por defecto false).
DRAKTER_VOICE_ALLOW_PAID=

# --- Automejora (backend/app/services/improvement_lab.py) ---
# Repositorio de pruebas donde se evalúan las propuestas. Sin él, evaluar queda bloqueado.
DRAKTER_IMPROVEMENT_REPO=

# --- Reservadas: nada las lee todavía (OpenViking, desactivado en v1) ---
OPENVIKING_ENDPOINT=
OPENVIKING_API_KEY=
